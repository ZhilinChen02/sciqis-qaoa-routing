  "continuation_rule": {
    "p_equal_1": "deterministic depth-derived initialization from base seed 2601",
    "p_greater_1": "inherit previous optimum; new gamma_p ~ U(0, 0.05); new beta_p ~ U(0, 0.05)"
  },
  "gamma_bounds": [0.0, 6.283185307179586],
  "beta_bounds": [0.0, 3.141592653589793],
  "penalty": 6.0,
  "graph_path": "data/graph.json",
  "grover_phase_operator": "exp(-i * gamma * C(P_i))",
  "threshold_mask_use": "BSP diagnostic only",
  "claim_quantum_advantage": false,
  "plan_reference": "project research plan, Sections 4.2 and 9.2"
}
