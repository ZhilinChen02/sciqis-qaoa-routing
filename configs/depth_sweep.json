{
  "schema": "dtu-sciqis-qaoa-depth110-extension",
  "version": "2.0",
  "title": "Depth-110 QAOA Main Track (Penalty-X vs Route-Cost Grover-Mixer)",
  "algorithms": ["penalty_x", "grover_cost_phase"],
  "depth_range": [1, 110],
  "base_seed": 2601,
  "depth_rng_seed_formula": "base_seed + 7919 * p",
