.venv/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
.ipynb_checkpoints/
.idea/
.vscode/
.DS_Store
*.swp
*.log

# Local credentials and Codex/session state must never be versioned.
KEY.txt
*.sqlite
*.sqlite-shm
*.sqlite-wal

# Development outputs are ignored. Selected immutable evidence roots are
# explicitly retained so a fresh clone can verify and plot the course results.
results/*
!results/.gitkeep
!results/q2_revision_formal/
!results/q2_revision_formal/**
!results/q2f_course_extension/
!results/q2f_course_extension/**
!results/q2f_final_improvement/
!results/q2f_final_improvement/**
!results/qaoa_dynamics_deep_dive/
!results/qaoa_dynamics_deep_dive/**
!results/depth110_ext/
!results/depth110_ext/v2/
!results/depth110_ext/v2/**

# Only the consolidated course presentation figures are versioned.
figures/*
!figures/.gitkeep
!figures/course/
!figures/course/**
!figures/qaoa_dynamics_deep_dive/
!figures/qaoa_dynamics_deep_dive/**
!figures/depth110_ext/
!figures/depth110_ext/v2/
!figures/depth110_ext/v2/**
