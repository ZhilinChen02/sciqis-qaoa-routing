# Development outputs are ignored. The three immutable evidence roots are
# explicitly retained so a fresh clone can verify and plot the course results.
results/*
!results/.gitkeep
!results/q2_revision_formal/
!results/q2_revision_formal/**
!results/q2f_course_extension/
!results/q2f_course_extension/**
!results/q2f_final_improvement/
!results/q2f_final_improvement/**

# Only the consolidated course presentation figures are versioned.
figures/*
!figures/.gitkeep
!figures/course/
!figures/course/**
